* text=auto eol=lf
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.bat text eol=crlf
*.jar binary
*.zip binary
*.ps1 text eol=lf
*.sh text eol=lf
*.tsv text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf
